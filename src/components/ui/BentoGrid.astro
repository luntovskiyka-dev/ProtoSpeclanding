---
/**
 * Bento Grid — adapted from Magic UI (Dillion Verma), MIT.
 * https://21st.dev/@dillionverma/components/bento-grid
 * https://github.com/magicuidesign/magicui
 */
import type { ChildLink } from '../../lib/pages';

interface Props {
  items: ChildLink[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class:list={['bento-grid', className]}>
  {
    items.map((item, index) => (
      <a
        href={item.href}
        class:list={['bento-card', index === 0 && 'bento-card--wide']}
      >
        <span class="bento-kicker">// 0{index + 1}</span>
        <span class="bento-title">{item.title}</span>
        <span class="bento-desc">{item.description}</span>
        <span class="bento-cta" aria-hidden="true">→</span>
      </a>
    ))
  }
</div>

<style>
  .bento-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }

  .bento-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    min-height: 10rem;
    padding: 1.15rem 1.2rem 1.25rem;
    border: 1px solid var(--ps-border);
    border-radius: var(--ps-radius-card);
    background: var(--ps-surface);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition:
      border-color 160ms ease-out,
      transform 160ms ease-out,
      background 160ms ease-out;
  }

  .bento-card:hover {
    border-color: var(--ps-accent);
    background: var(--ps-surface-2);
    transform: translateY(-2px);
  }

  .bento-kicker {
    font-family: var(--ps-font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ps-muted);
  }

  .bento-title {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--ps-text);
  }

  .bento-desc {
    color: var(--ps-muted);
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .bento-cta {
    margin-top: auto;
    align-self: flex-end;
    color: var(--ps-muted);
    transition: color 160ms ease-out, transform 160ms ease-out;
  }

  .bento-card:hover .bento-cta {
    color: var(--ps-accent);
    transform: translateX(2px);
  }

  @media (min-width: 720px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento-card--wide {
      grid-column: 1 / -1;
      min-height: 8.5rem;
    }
  }

  @media (min-width: 1100px) {
    .bento-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .bento-card--wide {
      grid-column: span 2;
      min-height: 12rem;
    }
  }
</style>
