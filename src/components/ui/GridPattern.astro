---
/**
 * Grid Pattern — adapted from Magic UI (Dillion Verma), MIT.
 * Source: design-refs/magicui/grid-pattern.tsx
 * https://github.com/magicuidesign/magicui
 */
interface Props {
  class?: string;
  width?: number;
  height?: number;
  x?: number;
  y?: number;
  strokeDasharray?: string;
}

const {
  class: className = '',
  width = 32,
  height = 32,
  x = -1,
  y = -1,
  strokeDasharray = '0',
} = Astro.props;
const patternId = `ps-grid-${Math.random().toString(36).slice(2, 9)}`;
---

<svg
  class:list={['grid-pattern', className]}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <pattern
      id={patternId}
      width={width}
      height={height}
      patternUnits="userSpaceOnUse"
      x={x}
      y={y}
    >
      <path
        d={`M.5 ${height}V.5H${width}`}
        fill="none"
        stroke="currentColor"
        stroke-dasharray={strokeDasharray}
      />
    </pattern>
    <radialGradient id={`${patternId}-fade`} cx="40%" cy="30%" r="65%">
      <stop offset="0%" stop-color="white" stop-opacity="1" />
      <stop offset="55%" stop-color="white" stop-opacity="0.4" />
      <stop offset="100%" stop-color="white" stop-opacity="0" />
    </radialGradient>
    <mask id={`${patternId}-mask`}>
      <rect width="100%" height="100%" fill={`url(#${patternId}-fade)`} />
    </mask>
  </defs>
  <rect
    width="100%"
    height="100%"
    stroke-width="0"
    fill={`url(#${patternId})`}
    mask={`url(#${patternId}-mask)`}
  />
</svg>

<style>
  .grid-pattern {
    pointer-events: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgb(255 255 255 / 0.05);
  }
</style>
