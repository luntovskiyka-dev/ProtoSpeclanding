---
/**
 * Border Beam — adapted from Magic UI (Dillion Verma), MIT.
 * Source: design-refs/magicui/border-beam.tsx
 * https://github.com/magicuidesign/magicui
 * Motion/framer replaced with CSS @keyframes on offset-distance.
 */
interface Props {
  class?: string;
  size?: number;
  duration?: number;
  delay?: number;
  colorFrom?: string;
  colorTo?: string;
  borderWidth?: number;
  reverse?: boolean;
  initialOffset?: number;
}

const {
  class: className = '',
  size = 120,
  duration = 10,
  delay = 0,
  colorFrom = 'var(--ps-accent)',
  colorTo = 'transparent',
  borderWidth = 1,
  reverse = false,
  initialOffset = 0,
} = Astro.props;

const start = reverse ? `${100 - initialOffset}%` : `${initialOffset}%`;
const end = reverse ? `${-initialOffset}%` : `${100 + initialOffset}%`;
---

<div
  class:list={['border-beam', className]}
  style={`--border-beam-width: ${borderWidth}px; --beam-size: ${size}px; --beam-duration: ${duration}s; --beam-delay: ${-delay}s; --color-from: ${colorFrom}; --color-to: ${colorTo}; --beam-from: ${start}; --beam-to: ${end};`}
  aria-hidden="true"
>
  <div class="border-beam-glow"></div>
</div>

<style>
  .border-beam {
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: var(--border-beam-width) solid transparent;
    mask-image: linear-gradient(transparent, transparent), linear-gradient(#000, #000);
    mask-composite: intersect;
    -webkit-mask-image: linear-gradient(transparent, transparent), linear-gradient(#000, #000);
    -webkit-mask-composite: source-in;
    mask-clip: padding-box, border-box;
    -webkit-mask-clip: padding-box, border-box;
  }

  .border-beam-glow {
    position: absolute;
    width: var(--beam-size);
    aspect-ratio: 1;
    background: linear-gradient(to left, var(--color-from), var(--color-to), transparent);
    offset-path: rect(0 auto auto 0 round var(--beam-size));
    offset-rotate: 0deg;
    offset-distance: var(--beam-from);
    animation: ps-border-beam var(--beam-duration) linear infinite;
    animation-delay: var(--beam-delay);
  }

  @keyframes ps-border-beam {
    from {
      offset-distance: var(--beam-from);
    }
    to {
      offset-distance: var(--beam-to);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .border-beam-glow {
      animation: none;
      opacity: 0;
    }
  }
</style>
