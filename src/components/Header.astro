---
import type { NavItem } from '../lib/pages';
import Logo from './Logo.astro';

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;
const path = Astro.url.pathname.replace(/\.html$/, '') || '/';
const generatorCurrent = path === '/generator';
---

<header class="site-header">
  <div class="header-inner wrap-wide">
    <Logo class="header-logo" />
    <nav aria-label="Разделы" class="header-nav">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="header-link"
            aria-current={item.current ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <a
      href="/generator"
      class="header-cta btn btn-primary"
      aria-current={generatorCurrent ? 'page' : undefined}
    >
      Генератор
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--ps-border);
    background: rgb(10 10 11 / 0.72);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'logo cta'
      'nav nav';
    align-items: center;
    column-gap: 1rem;
    row-gap: 0;
    min-height: 3.5rem;
  }

  .header-logo {
    grid-area: logo;
    min-height: 3.5rem;
  }

  .header-nav {
    grid-area: nav;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    height: 2.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .header-nav::-webkit-scrollbar {
    display: none;
  }

  .header-link {
    flex-shrink: 0;
    color: var(--ps-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 160ms ease-out;
  }

  .header-link:hover {
    color: var(--ps-text);
  }

  .header-link[aria-current='page'] {
    color: var(--ps-text);
  }

  .header-cta {
    grid-area: cta;
    height: 2rem;
    padding: 0 0.875rem;
    font-size: 0.8125rem;
  }

  @media (min-width: 900px) {
    .header-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'logo nav cta';
      column-gap: 1.75rem;
      min-height: 4rem;
    }

    .header-logo {
      min-height: 4rem;
    }

    .header-nav {
      height: auto;
      overflow: visible;
    }
  }
</style>
