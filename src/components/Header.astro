---
import type { NavItem } from '../lib/pages';

interface Props {
  nav: NavItem[];
}

const { nav } = Astro.props;
---

<header class="site-header border-b">
  <div class="wrap flex flex-wrap items-center gap-x-6 gap-y-3 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight text-ink no-underline">ProtoSpec</a>
    <nav aria-label="Разделы" class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class="text-ink no-underline hover:underline"
            aria-current={item.current ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>
