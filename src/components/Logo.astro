---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label="ProtoSpec — на главную">
  <svg class="logo-mark" width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
    <rect x="1" y="1" width="26" height="26" rx="6" fill="var(--ps-accent-soft)" stroke="var(--ps-accent)" stroke-width="1.5" />
    <path
      d="M8 18.5V9.5h4.2c2.1 0 3.4 1.15 3.4 2.85 0 1.15-.6 2.05-1.55 2.45L16.5 18.5h-2.35l-2.05-3.35H10.2V18.5H8Zm2.2-5.15h1.85c.95 0 1.5-.5 1.5-1.2s-.55-1.2-1.5-1.2H10.2v2.4Z"
      fill="var(--ps-accent)"
    />
    <path d="M17.8 18.5 20.6 9.5h2.15l2.8 9H23.2l-.45-1.55h-2.95l-.45 1.55h-1.55Zm2.05-3.35h2.15l-1.05-3.55-1.1 3.55Z" fill="var(--ps-text)" opacity="0.9" />
  </svg>
  <span class="logo-word">ProtoSpec</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ps-text);
    text-decoration: none;
  }

  .logo-mark {
    flex-shrink: 0;
  }

  .logo-word {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1;
  }
</style>
