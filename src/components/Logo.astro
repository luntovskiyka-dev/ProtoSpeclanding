---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<a href="/" class:list={['logo', className]} aria-label="ProtoSpec — на главную">
  <span class="logo-word">ProtoSpec<span class="logo-dot">.</span></span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--ps-text);
    text-decoration: none;
    align-self: stretch;
  }

  .logo-word {
    font-family: var(--ps-font-heading);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .logo-dot {
    color: var(--ps-accent);
  }
</style>
