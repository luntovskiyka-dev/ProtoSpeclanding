---
import onestCyrillicUrl from '@fontsource-variable/onest/files/onest-cyrillic-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FaqList from '../components/FaqList.astro';
import {
  ROBOTS_NOINDEX,
  VERIFICATION_TAGS,
  buildJsonLd,
  canonicalUrl,
  serializeJsonLd,
  shouldNoindex,
  type Crumb,
  type FaqItem,
  type PageKind,
} from '../lib/seo';
import type { NavItem } from '../lib/pages';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  kind: PageKind;
  draft: boolean;
  nav: NavItem[];
  breadcrumbs?: Crumb[];
  faq?: FaqItem[];
  ogType?: 'website' | 'article';
  wide?: boolean;
}

const {
  title,
  description,
  path,
  h1,
  kind,
  draft,
  nav,
  breadcrumbs = [],
  faq = [],
  ogType = kind === 'article' ? 'article' : 'website',
  wide = false,
} = Astro.props;

const canonical = canonicalUrl(path);
const noindex = shouldNoindex({ draft });
const jsonLd = buildJsonLd({ path, description, h1, kind, breadcrumbs, faq });
const canonicalTag = `<link rel="canonical" href="${canonical}">`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <Fragment set:html={VERIFICATION_TAGS} />
    <title>{title}</title>
    <meta name="description" content={description}>
    <Fragment set:html={canonicalTag} />
    {noindex && <Fragment set:html={ROBOTS_NOINDEX} />}
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonical}>
    <meta property="og:type" content={ogType}>
    <meta property="og:locale" content="ru_RU">
    <meta property="og:site_name" content="ProtoSpec">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link
      rel="preload"
      href={onestCyrillicUrl}
      as="font"
      type="font/woff2"
      crossorigin
    />
    {jsonLd && <script type="application/ld+json" is:inline set:html={serializeJsonLd(jsonLd)} />}
  </head>
  <body class="bg-bg text-ink">
    <a class="skip" href="#main">К содержанию</a>
    <Header nav={nav} />
    <main id="main" class="pb-16">
      <div class={wide ? 'wrap-wide' : 'wrap'}>
        {path !== '/' && breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} />}
        <slot />
        <FaqList items={faq} />
      </div>
    </main>
    <Footer />
    <script is:inline>
      (function () {
        function copyText(text) {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            return navigator.clipboard.writeText(text);
          }
          return new Promise(function (resolve, reject) {
            var area = document.createElement('textarea');
            area.value = text;
            area.setAttribute('readonly', '');
            area.style.position = 'fixed';
            area.style.left = '-9999px';
            document.body.appendChild(area);
            area.select();
            try {
              document.execCommand('copy') ? resolve() : reject(new Error('copy'));
            } catch (error) {
              reject(error);
            } finally {
              document.body.removeChild(area);
            }
          });
        }

        document.querySelectorAll('[data-copy]').forEach(function (btn) {
          if (!(btn instanceof HTMLButtonElement) || btn.dataset.copyBound === '1') return;
          btn.dataset.copyBound = '1';
          var timer = 0;
          btn.addEventListener('click', function () {
            var root = btn.closest('[data-copy-root]');
            var code = root ? root.querySelector('code') : null;
            var text = code ? code.textContent || '' : '';
            copyText(text).then(function () {
              window.clearTimeout(timer);
              btn.textContent = 'Скопировано';
              btn.setAttribute('aria-label', 'Скопировано');
              timer = window.setTimeout(function () {
                btn.textContent = 'Скопировать';
                btn.setAttribute('aria-label', 'Скопировать');
              }, 2000);
            }).catch(function () {});
          });
        });
      })();
    </script>
  </body>
</html>
